# Cloudflare Pages response headers.
#
# The rule that matters for the back/forward cache: the HTML document must never be
# served with `Cache-Control: no-store`. That value disqualifies a page from bfcache
# outright in Chrome, and the symptom is invisible — back navigation is simply slow,
# with nothing logged anywhere. `no-cache` is fine and is what we want: revalidate
# every time, but stay eligible.
#
# See src/lib/lifecycle.ts for the rest of the bfcache constraints.

/*
  # Referrer and framing. A medication tracker has no business being embedded.
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  #
  # Cloudflare currently overrides the two values above. Its "Add security headers" managed
  # transform is enabled on the zone, and production answers with `X-Frame-Options: SAMEORIGIN`
  # and `Referrer-Policy: same-origin` however this file is written — verified against the live
  # domain, while HSTS and the cache rules from this same file arrive intact. Neither
  # substitution is dangerous: `frame-ancestors 'none'` below is what actually blocks framing
  # and takes precedence over X-Frame-Options in every current browser, and `same-origin` is
  # the stricter referrer choice. The values here are kept as the intended policy rather than
  # edited to match, so that turning the transform off needs no change to this file.
  # `.github/workflows/headers.yml` checks what the live domain really sends, because a test
  # over this file cannot see a dashboard setting.
  #
  # Capabilities the app never uses, refused rather than merely unused. This is the promise in
  # the privacy note stated as a header: an app that cannot reach the camera, the microphone or
  # the location cannot leak them, whatever a future dependency tries. `browsing-topics=()`
  # opts out of Chrome's Topics API, which would otherwise let the browser derive advertising
  # interests from a visit to a transplant medication tracker.
  #
  # `clipboard-write` is deliberately NOT listed. Copying the pharmacy order is how the order
  # actually reaches the pharmacy — see the copy button in src/routes/order/+page.svelte — and
  # denying it here would break that screen silently, with the button doing nothing and no
  # error anywhere. The stock "deny everything" list in most hardening guides does exactly
  # that. src/lib/headers.test.ts fails if it is ever added.
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  #
  # No cross-origin window ever opens one of these documents, and none of them opens one. This
  # severs `window.opener` both ways, so anything reached from here cannot reach back in.
  #
  # Cross-Origin-Resource-Policy is deliberately absent. It was considered and rejected: no
  # resource on this origin is confidential — the regimen lives in IndexedDB, which no request
  # can reach — and the assets that are used off-origin exist *for* that, since the lockups are
  # for the README and printed handouts and the social card is fetched by whatever is unfurling
  # a link. The header would protect nothing here and put link previews at risk.
  Cross-Origin-Opener-Policy: same-origin
  # No third-party scripts at all, and no outbound connections carrying health data.
  # The full policy is generated in vite.config.ts and delivered in a <meta> tag, because
  # its hashes have to describe the bundle that actually shipped. `frame-ancestors` stays
  # here: browsers ignore it in a <meta> tag.
  Content-Security-Policy: frame-ancestors 'none'
  # Redundant on `.app`, which is HSTS-preloaded at the top level, so browsers already
  # refuse plain HTTP for the whole TLD. Present anyway, because it costs one line and the
  # protection would otherwise be silently absent if the app were ever served from a domain
  # without that guarantee. No `preload` directive: the TLD already covers us, and asking to
  # be on the preload list is a commitment that buys nothing here.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Every prerendered document, revalidated on every request.
#
# Each route is prerendered as its own HTML shell, and each one references asset filenames
# that contain a content hash. So a stale document is not merely out of date — it points at
# files that no longer exist after the next deploy, and the app fails to boot. The list must
# cover every route; `src/lib/headers.test.ts` fails if one is missing.
#
# `/` needs its own entry. Cloudflare matches the request path, and a request for `/` does
# not match `/index.html`.
#
# `no-transform` is what stops Cloudflare rewriting these documents at the edge. Bot Fight
# Mode enables JavaScript Detections, which injects an inline script and a hidden iframe into
# every HTML response, and Cloudflare's documentation states it "cannot be disabled" for that
# plan and is "not supported with nonce set via <meta> tags" — which is exactly how this app's
# policy is delivered. So the injected script is blocked by the CSP and logs a violation on
# every page load. `no-transform` is the documented way to opt out: Cloudflare skips injection
# when the origin sends it. It carries no caching cost, unlike `no-store`, which would disable
# bfcache.
/
  Cache-Control: no-cache, no-transform

/index.html
  Cache-Control: no-cache, no-transform

/stock
  Cache-Control: no-cache, no-transform

/order
  Cache-Control: no-cache, no-transform

/setup
  Cache-Control: no-cache, no-transform

/about
  Cache-Control: no-cache, no-transform

/privacy
  Cache-Control: no-cache, no-transform

/roadmap
  Cache-Control: no-cache, no-transform

/support
  Cache-Control: no-cache, no-transform

/404.html
  Cache-Control: no-cache, no-transform

# Hashed filenames, so these can never go stale.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Must revalidate, or an update can never be picked up.
/service-worker.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
